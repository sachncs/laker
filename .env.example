# LAKER Environment Configuration
# ================================
# All variables are optional. Copy this file to `.env` or export them in
# your shell. The package reads each variable once at import time via
# `laker.backend.Backend.load_env()`.

# ----- Compute device --------------------------------------------------
# Any string accepted by `torch.device`. When unset, the package
# auto-selects CUDA -> MPS -> CPU in that order.
# LAKER_DEVICE=cpu

# ----- Floating-point dtype --------------------------------------------
# One of "float16", "bfloat16", "float32", "float64". Anything else is
# ignored to avoid silent type surprises.
# LAKER_DTYPE=float32

# ----- Chunking ---------------------------------------------------------
# Memory budget for chunked kernel evaluation, in megabytes. The chunk
# size is selected so each tile stays under this budget.
LAKER_CHUNK_MEMORY_BUDGET=64

# Force-disable chunking everywhere. Set to "1" to disable.
# LAKER_DISABLE_CHUNK=0

# ----- Compilation -----------------------------------------------------
# Set to "default", "reduce-overhead", or "max-autotune" to opt the hot
# matvec paths into `torch.compile`. Unset disables compilation.
# LAKER_COMPILE_MODE=

# ----- Numerical behaviour ---------------------------------------------
# Autocast at inference. Set to "1" to enable.
# LAKER_AUTOCAST=0

# Allow TF32 matmuls on Ampere+ GPUs. Default "1".
# LAKER_TF32=1

# Torch CPU thread count. "0" leaves it at the platform default.
# LAKER_NUM_THREADS=0

# Global seed. Setting it seeds torch.manual_seed at import time.
# LAKER_SEED=42

# ----- Logging ---------------------------------------------------------
# Default verbosity for Laker(verbose=...).
# LAKER_VERBOSE=1

# Python logging level for the `laker` logger.
LAKER_LOG_LEVEL=INFO

# ----- CI ---------------------------------------------------------------
# Codecov token (do not commit a real value).
# CODECOV_TOKEN=
