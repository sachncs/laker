---
// EncoderLoop — a tight schematic of the encoder → kernel → solver → loss loop,
// with a "backprop through kernel" annotation.
---

<svg viewBox="0 0 320 90" xmlns="http://www.w3.org/2000/svg" class="block w-full">
  <defs>
    <marker id="enc-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="rgba(255,255,255,0.45)" />
    </marker>
    <marker id="enc-arrow-rev" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="rgba(196,181,255,0.85)" />
    </marker>
  </defs>

  <g font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="9" fill="rgba(255,255,255,0.6)">
    <!-- Forward path -->
    <rect x="6"   y="20" width="58" height="34" rx="8" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.10)" />
    <text x="35"  y="36" text-anchor="middle" fill="rgba(255,255,255,0.9)">Encoder</text>
    <text x="35"  y="48" text-anchor="middle" fill="rgba(133,183,255,0.85)">E = φ(x)</text>

    <line x1="64" y1="37" x2="84" y2="37" stroke="rgba(255,255,255,0.3)" stroke-width="1.2" marker-end="url(#enc-arrow)" />

    <rect x="86"  y="20" width="58" height="34" rx="8" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.10)" />
    <text x="115" y="36" text-anchor="middle" fill="rgba(255,255,255,0.9)">Kernel</text>
    <text x="115" y="48" text-anchor="middle" fill="rgba(94,227,208,0.85)">G = exp(EEᵀ)</text>

    <line x1="144" y1="37" x2="164" y2="37" stroke="rgba(255,255,255,0.3)" stroke-width="1.2" marker-end="url(#enc-arrow)" />

    <rect x="166" y="20" width="58" height="34" rx="8" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.10)" />
    <text x="195" y="36" text-anchor="middle" fill="rgba(255,255,255,0.9)">Solve</text>
    <text x="195" y="48" text-anchor="middle" fill="rgba(94,227,208,0.85)">PCG → α*</text>

    <line x1="224" y1="37" x2="244" y2="37" stroke="rgba(255,255,255,0.3)" stroke-width="1.2" marker-end="url(#enc-arrow)" />

    <rect x="246" y="20" width="68" height="34" rx="8" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.10)" />
    <text x="280" y="36" text-anchor="middle" fill="rgba(255,255,255,0.9)">Predict</text>
    <text x="280" y="48" text-anchor="middle" fill="rgba(133,183,255,0.85)">f(x) = Gα</text>

    <!-- Backward path (curved, purple) -->
    <path d="M 280 60 C 280 80, 35 80, 35 56" fill="none" stroke="rgba(196,181,255,0.55)" stroke-width="1.2" stroke-dasharray="3 4" marker-end="url(#enc-arrow-rev)" />
    <text x="148" y="78" text-anchor="middle" fill="rgba(196,181,255,0.8)">∇_φ L · adjoint through K</text>
  </g>
</svg>