---
import { SITE } from '~/lib/site';

const groups = [
  {
    title: 'Product',
    links: [
      { label: 'Overview', href: '#overview' },
      { label: 'Architecture', href: '#architecture' },
      { label: 'Benchmarks', href: '#benchmarks' },
      { label: 'Quick start', href: '#quick-start' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Paper · arXiv', href: SITE.paper },
      { label: 'Source on GitHub', href: SITE.repo },
      { label: 'PyPI package', href: SITE.pypi },
      { label: 'Citation', href: SITE.paper },
    ],
  },
  {
    title: 'Community',
    links: [
      { label: 'Issues', href: SITE.social.issues },
      { label: 'Discussions', href: SITE.social.discussions },
      { label: 'Changelog', href: `${SITE.repo}/blob/master/CHANGELOG.md` },
      { label: 'Contributing', href: `${SITE.repo}/blob/master/CONTRIBUTING.md` },
    ],
  },
];
---

<footer class="relative border-t hairline-t">
  <div class="container-x py-16">
    <div class="grid grid-cols-2 lg:grid-cols-12 gap-10">
      <div class="col-span-2 lg:col-span-6">
        <a href="/" class="flex items-center gap-2.5">
          <span class="relative inline-flex h-7 w-7 items-center justify-center rounded-md bg-white/[0.04] ring-1 ring-white/[0.08]">
            <span class="absolute inset-0 rounded-md bg-gradient-to-br from-[#5ee3d0]/30 via-[#85b7ff]/20 to-[#c4b5ff]/30 opacity-70"></span>
            <svg viewBox="0 0 24 24" class="relative h-4 w-4 text-white/90" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M3 12c2.5-7 6-10 9-10s6.5 3 9 10c-2.5 7-6 10-9 10s-6.5-3-9-10Z" />
              <circle cx="12" cy="12" r="2.2" fill="currentColor" stroke="none" />
            </svg>
          </span>
          <span class="font-semibold tracking-tight text-[15px] text-white">LAKER</span>
        </a>
        <p class="mt-5 text-[14px] leading-[1.65] text-white/50 max-w-[40ch]">
          Learning-based Attention Kernel Regression. A PyTorch library for
          scalable spectrum cartography with a learned preconditioner.
        </p>
        <p class="mt-3 text-[12.5px] text-white/35 leading-[1.6] max-w-[40ch]">
          Tao &amp; Tan, 2026 · <a href={SITE.paper} class="hover:text-white underline decoration-white/20 underline-offset-4">arXiv:2604.25138</a>
        </p>

        <div class="mt-6 flex items-center gap-3">
          <a href={SITE.social.github} target="_blank" rel="noopener" class="btn btn-ghost h-9 px-3 text-[12.5px]" aria-label="View on GitHub">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.73.5.66 5.58.66 11.85c0 4.99 3.23 9.22 7.72 10.71.56.1.77-.24.77-.55v-2.1c-3.14.68-3.8-1.34-3.8-1.34-.51-1.31-1.25-1.66-1.25-1.66-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.57 0-1.23.44-2.24 1.16-3.03-.12-.29-.5-1.45.11-3.02 0 0 .95-.31 3.1 1.16a10.7 10.7 0 0 1 5.65 0c2.15-1.47 3.1-1.16 3.1-1.16.61 1.57.23 2.73.11 3.02.72.79 1.16 1.8 1.16 3.03 0 4.33-2.63 5.29-5.14 5.57.4.34.76 1.02.76 2.07v3.07c0 .31.21.66.78.55 4.49-1.49 7.72-5.72 7.72-10.71C23.34 5.58 18.27.5 12 .5Z" />
            </svg>
            <span>GitHub</span>
          </a>
          <a href={SITE.pypi} target="_blank" rel="noopener" class="btn btn-ghost h-9 px-3 text-[12.5px]" aria-label="View on PyPI">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
              <path d="M12 2 1 7l11 5 11-5-11-5Zm-1 7.6L2 5.6v3.5l9 4.1 9-4.1V5.6l-9 4Z" />
              <path d="M2 12.5v3.5l10 4.5 10-4.5v-3.5l-10 4.5-10-4.5Z" />
            </svg>
            <span>PyPI</span>
          </a>
        </div>
      </div>

      {
        groups.map((g) => (
          <div class="lg:col-span-2">
            <div class="text-[11px] uppercase tracking-[0.18em] text-white/35 font-mono">{g.title}</div>
            <ul class="mt-4 space-y-2.5">
              {g.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="text-[13.5px] text-white/65 hover:text-white transition-colors"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="hairline mt-14"></div>

    <div class="mt-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-[12px] text-white/35">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <span>© 2026 LAKER Contributors.</span>
        <span class="text-white/15">·</span>
        <span>MIT License.</span>
        <span class="text-white/15">·</span>
        <span>v{SITE.version}</span>
      </div>
      <div class="flex items-center gap-4 font-mono">
        <a href="https://github.com/sachncs/laker" target="_blank" rel="noopener" class="hover:text-white">{SITE.repoShort}</a>
      </div>
    </div>
  </div>
</footer>