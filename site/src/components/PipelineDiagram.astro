---
// PipelineDiagram — a horizontal flow showing inputs flowing through
// Encode → Kernel → CCCP Preconditioner → PCG Solve → Predict,
// with data tokens, the kernel operator visual, and an animated
// highlight passing through the stages.
---

<svg viewBox="0 0 1100 320" xmlns="http://www.w3.org/2000/svg" role="img"
     aria-label="Pipeline diagram: inputs flow through Encode, Kernel, CCCP Preconditioner, PCG Solve, and Predict."
     class="block w-full">
  <defs>
    <linearGradient id="pipe-stroke" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="rgba(255,255,255,0.15)" />
      <stop offset="50%" stop-color="rgba(255,255,255,0.45)" />
      <stop offset="100%" stop-color="rgba(255,255,255,0.15)" />
    </linearGradient>
    <linearGradient id="pipe-fill" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="rgba(255,255,255,0.06)" />
      <stop offset="100%" stop-color="rgba(255,255,255,0.01)" />
    </linearGradient>

    <radialGradient id="token-grad" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0%" stop-color="#5ee3d0" />
      <stop offset="100%" stop-color="#22b3c9" stop-opacity="0.5" />
    </radialGradient>
    <radialGradient id="token-grad-2" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0%" stop-color="#85b7ff" />
      <stop offset="100%" stop-color="#1a52d6" stop-opacity="0.5" />
    </radialGradient>

    <pattern id="pipe-grid" width="14" height="14" patternUnits="userSpaceOnUse">
      <path d="M14 0 L0 0 L0 14" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="1" />
    </pattern>
  </defs>

  <!-- Background grid -->
  <rect x="0" y="0" width="1100" height="320" fill="url(#pipe-grid)" opacity="0.5" />

  <!-- Pipeline rail -->
  <rect x="20" y="120" width="1060" height="80" rx="40" fill="url(#pipe-fill)" stroke="url(#pipe-stroke)" />

  <!-- Animated tokens flowing through the pipe -->
  <g>
    <circle r="6" fill="url(#token-grad)">
      <animateMotion dur="6s" repeatCount="indefinite" rotate="auto" path="M30 160 L1070 160" />
    </circle>
    <circle r="4" fill="url(#token-grad-2)">
      <animateMotion dur="6s" repeatCount="indefinite" begin="1.5s" rotate="auto" path="M30 160 L1070 160" />
    </circle>
    <circle r="5" fill="url(#token-grad)">
      <animateMotion dur="6s" repeatCount="indefinite" begin="3s" rotate="auto" path="M30 160 L1070 160" />
    </circle>
    <circle r="4" fill="url(#token-grad-2)">
      <animateMotion dur="6s" repeatCount="indefinite" begin="4.5s" rotate="auto" path="M30 160 L1070 160" />
    </circle>
  </g>

  <!-- Stage nodes -->
  <g font-family="ui-sans-serif, system-ui, sans-serif">
    <!-- Node 1: Encode -->
    <g transform="translate(120,160)">
      <circle r="58" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.10)" />
      <circle r="46" fill="rgba(0,0,0,0.4)" stroke="rgba(255,255,255,0.08)" />
      <text y="-8" text-anchor="middle" font-size="10" fill="rgba(255,255,255,0.5)" letter-spacing="2px">01 · ENCODE</text>
      <!-- Token → Embedding transformation glyph -->
      <g transform="translate(0,4)" stroke="rgba(255,255,255,0.55)" fill="none">
        <rect x="-22" y="-8" width="14" height="14" rx="2" />
        <line x1="-8" y1="-1" x2="22" y2="-1" marker-end="url(#n-arrow)" />
        <rect x="22" y="-12" width="6" height="6" fill="rgba(94,227,208,0.4)" />
        <rect x="22" y="-2"  width="6" height="6" fill="rgba(94,227,208,0.4)" />
        <rect x="22" y="8"   width="6" height="6" fill="rgba(94,227,208,0.4)" />
      </g>
      <text y="38" text-anchor="middle" font-size="11" fill="rgba(255,255,255,0.85)">φ : ℝᵈ → ℝᵏ</text>
    </g>

    <!-- Node 2: Kernel -->
    <g transform="translate(340,160)">
      <circle r="58" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.10)" />
      <circle r="46" fill="rgba(0,0,0,0.4)" stroke="rgba(255,255,255,0.08)" />
      <text y="-8" text-anchor="middle" font-size="10" fill="rgba(255,255,255,0.5)" letter-spacing="2px">02 · KERNEL</text>
      <!-- Low-rank glyph -->
      <g transform="translate(0,4)" fill="rgba(94,227,208,0.7)">
        <rect x="-22" y="-12" width="4" height="24" />
        <rect x="-14" y="-12" width="4" height="24" />
        <rect x="-6"  y="-12" width="4" height="24" />
        <rect x="2"   y="-12" width="4" height="24" />
        <rect x="10"  y="-12" width="4" height="24" />
        <rect x="18"  y="-12" width="4" height="24" />
      </g>
      <text y="38" text-anchor="middle" font-size="11" fill="rgba(255,255,255,0.85)">G = exp(E Eᵀ)</text>
    </g>

    <!-- Node 3: CCCP (highlighted) -->
    <g transform="translate(580,160)">
      <circle r="68" fill="rgba(94,227,208,0.06)" stroke="rgba(94,227,208,0.5)" />
      <circle r="56" fill="rgba(0,0,0,0.4)" stroke="rgba(94,227,208,0.25)" />
      <text y="-10" text-anchor="middle" font-size="10" fill="rgba(94,227,208,0.9)" letter-spacing="2px">03 · CCCP</text>
      <!-- Factored preconditioner glyph -->
      <g transform="translate(0,4)" stroke="rgba(94,227,208,0.85)" fill="none">
        <rect x="-26" y="-12" width="14" height="22" rx="2" />
        <line x1="-12" y1="0" x2="14" y2="0" />
        <rect x="14" y="-12" width="14" height="22" rx="2" />
        <text x="0" y="3" text-anchor="middle" font-family="ui-monospace, monospace" font-size="11" fill="rgba(94,227,208,0.9)" stroke="none">P</text>
      </g>
      <text y="42" text-anchor="middle" font-size="11" fill="rgba(255,255,255,0.9)">P ≈ (G + λI)⁻¹</text>
    </g>

    <!-- Node 4: PCG -->
    <g transform="translate(800,160)">
      <circle r="58" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.10)" />
      <circle r="46" fill="rgba(0,0,0,0.4)" stroke="rgba(255,255,255,0.08)" />
      <text y="-8" text-anchor="middle" font-size="10" fill="rgba(255,255,255,0.5)" letter-spacing="2px">04 · SOLVE</text>
      <!-- PCG descent glyph -->
      <g transform="translate(0,4)" stroke="rgba(133,183,255,0.85)" fill="none" stroke-width="1.4">
        <path d="M-24 8 Q -8 -2, 8 4 T 24 -2" />
        <circle cx="-24" cy="8"  r="2" fill="rgba(133,183,255,0.85)" />
        <circle cx="24"  cy="-2" r="2" fill="rgba(133,183,255,0.85)" />
      </g>
      <text y="38" text-anchor="middle" font-size="11" fill="rgba(255,255,255,0.85)">PCG → α*</text>
    </g>

    <!-- Node 5: Predict -->
    <g transform="translate(1000,160)">
      <circle r="58" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.10)" />
      <circle r="46" fill="rgba(0,0,0,0.4)" stroke="rgba(255,255,255,0.08)" />
      <text y="-8" text-anchor="middle" font-size="10" fill="rgba(255,255,255,0.5)" letter-spacing="2px">05 · PREDICT</text>
      <!-- Posterior glyph -->
      <g transform="translate(0,4)">
        <path d="M-22 8 Q -10 -8, 0 0 T 22 -8" stroke="rgba(245,194,119,0.85)" fill="none" stroke-width="1.4" />
        <path d="M-22 6 L 22 6 M -22 -8 L 22 -8" stroke="rgba(245,194,119,0.35)" fill="none" stroke-dasharray="2 3" />
      </g>
      <text y="38" text-anchor="middle" font-size="11" fill="rgba(255,255,255,0.85)">μ(x), σ²(x)</text>
    </g>
  </g>

  <!-- Inputs / outputs labels -->
  <g font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10" fill="rgba(255,255,255,0.5)">
    <text x="20"   y="80"  letter-spacing="1.5">INPUT · x ∈ ℝⁿˣᵈ</text>
    <text x="20"   y="265" letter-spacing="1.5">y ∈ ℝⁿ · measurements</text>
    <text x="1050" y="80"  text-anchor="end" letter-spacing="1.5">μ̂(x*) · σ̂²(x*)</text>
    <text x="1050" y="265" text-anchor="end" letter-spacing="1.5">α* ∈ ℝⁿ · coefficients</text>
  </g>

  <!-- Side info chips -->
  <g font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10" fill="rgba(255,255,255,0.55)">
    <rect x="514" y="42" width="132" height="22" rx="6" fill="rgba(94,227,208,0.08)" stroke="rgba(94,227,208,0.4)" />
    <text x="580" y="56" text-anchor="middle" fill="rgba(94,227,208,0.9)">learned · data-dependent</text>

    <rect x="40" y="42" width="160" height="22" rx="6" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.10)" />
    <text x="120" y="56" text-anchor="middle">O(n · r) matvec · r ≪ n</text>

    <rect x="916" y="42" width="148" height="22" rx="6" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.10)" />
    <text x="990" y="56" text-anchor="middle">≈constant iters</text>
  </g>
</svg>