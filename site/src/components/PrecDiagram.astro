---
// PrecDiagram — visualises the CCCP preconditioner as a small block schematic.
// Encodes E → K = exp(EEᵀ) → CCCP → P ≈ K⁻¹.
---

<svg viewBox="0 0 480 140" xmlns="http://www.w3.org/2000/svg" class="block w-full">
  <defs>
    <linearGradient id="prec-block" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="rgba(94,227,208,0.10)" />
      <stop offset="100%" stop-color="rgba(94,227,208,0.02)" />
    </linearGradient>
    <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="rgba(255,255,255,0.45)" />
    </marker>
  </defs>

  <g font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10" fill="rgba(255,255,255,0.55)">
    <!-- Embeddings block -->
    <rect x="10" y="36" width="86" height="68" rx="10" fill="url(#prec-block)" stroke="rgba(255,255,255,0.10)" />
    <text x="53" y="58" text-anchor="middle" fill="rgba(255,255,255,0.85)" font-weight="500">Embeddings</text>
    <text x="53" y="74" text-anchor="middle">E ∈ ℝⁿˣᵈ</text>
    <text x="53" y="92" text-anchor="middle" fill="rgba(94,227,208,0.85)">Encoder</text>

    <!-- Arrow -->
    <line x1="98" y1="70" x2="124" y2="70" stroke="rgba(255,255,255,0.3)" stroke-width="1.2" marker-end="url(#arrow)" />

    <!-- Kernel block -->
    <rect x="126" y="36" width="92" height="68" rx="10" fill="url(#prec-block)" stroke="rgba(255,255,255,0.10)" />
    <text x="172" y="58" text-anchor="middle" fill="rgba(255,255,255,0.85)" font-weight="500">Attention</text>
    <text x="172" y="74" text-anchor="middle">G = exp(EEᵀ)</text>
    <text x="172" y="92" text-anchor="middle" fill="rgba(94,227,208,0.85)">+ Low-rank</text>

    <line x1="220" y1="70" x2="246" y2="70" stroke="rgba(255,255,255,0.3)" stroke-width="1.2" marker-end="url(#arrow)" />

    <!-- CCCP block (highlighted) -->
    <rect x="248" y="28" width="100" height="84" rx="12" fill="rgba(94,227,208,0.06)" stroke="rgba(94,227,208,0.5)" />
    <text x="298" y="50" text-anchor="middle" fill="rgba(255,255,255,0.95)" font-weight="500">CCCP</text>
    <text x="298" y="66" text-anchor="middle">shrinkage</text>
    <text x="298" y="82" text-anchor="middle">P ≈ (G + λI)⁻¹</text>
    <text x="298" y="100" text-anchor="middle" fill="rgba(94,227,208,0.85)">factored</text>

    <line x1="350" y1="70" x2="376" y2="70" stroke="rgba(255,255,255,0.3)" stroke-width="1.2" marker-end="url(#arrow)" />

    <!-- Solve block -->
    <rect x="378" y="36" width="92" height="68" rx="10" fill="url(#prec-block)" stroke="rgba(255,255,255,0.10)" />
    <text x="424" y="58" text-anchor="middle" fill="rgba(255,255,255,0.85)" font-weight="500">PCG</text>
    <text x="424" y="74" text-anchor="middle">α* = (G+λI)⁻¹y</text>
    <text x="424" y="92" text-anchor="middle" fill="rgba(94,227,208,0.85)">≈ constant iters</text>
  </g>
</svg>