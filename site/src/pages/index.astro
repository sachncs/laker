---
import Base from '~/layouts/Base.astro';
import Nav from '~/components/Nav.astro';
import Hero from '~/components/Hero.astro';
import SocialProof from '~/components/SocialProof.astro';
import Overview from '~/components/Overview.astro';
import Features from '~/components/Features.astro';
import Architecture from '~/components/Architecture.astro';
import QuickStart from '~/components/QuickStart.astro';
import Benchmarks from '~/components/Benchmarks.astro';
import Kernels from '~/components/Kernels.astro';
import CTA from '~/components/CTA.astro';
import Footer from '~/components/Footer.astro';
---

<Base>
