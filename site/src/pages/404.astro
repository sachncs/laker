---
import Base from '~/layouts/Base.astro';
---

<Base title="Page not found · LAKER">
  <main class="shell min-h-[80vh] flex items-center">
    <div class="container-x py-24">
      <div class="max-w-[520px] reveal">
        <p class="eyebrow">404</p>
        <h1 class="display mt-5 text-[44px] sm:text-[64px] leading-[0.96]">
          Off the <em>map.</em>
        </h1>
        <p class="mt-6 text-[16px] leading-[1.7] text-white/55">
          The page you're looking for isn't here. It might have moved, been
          renamed, or never existed.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/" class="btn btn-primary h-11 px-5 text-[14px]">← Back home</a>
          <a href="https://github.com/sachncs/laker" target="_blank" rel="noopener" class="btn btn-ghost h-11 px-5 text-[14px]">
            View on GitHub
          </a>
        </div>
      </div>
    </div>
  </main>
</Base>